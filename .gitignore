# Public release allowlist: only reviewed v6 benchmark material is tracked.
/*
!/.gitignore
!/README.md
!/PUBLICATION.md
!/THIRD_PARTY_NOTICES.md
!/docs/
/docs/*
!/docs/index.html
!/docs/assets/
/docs/assets/*
!/docs/assets/ziwei.png
!/docs/assets/results.csv
!/docs/assets/evidence.md
!/docs/assets/script.md
!/docs/assets/Wolke-LICENSE.txt
!/harness/
/harness/*
!/harness/score_v6_consumer.py
!/harness/score_v6_consumer_adjudicated.py
!/scripts/
/scripts/*
!/scripts/verify_release.py
!/scripts/reproduce_scores.py
!/datasets/
/datasets/*
!/datasets/gold/
/datasets/gold/*
!/datasets/gold/v6-events.jsonl
!/reports/
/reports/*
!/reports/v6-consumer-scores.json
!/reports/v6-consumer-results.csv
!/reports/publication/
/reports/publication/*
!/reports/publication/人生变化命理测评-v6.md
!/reports/publication/人生变化命理测评-v6-证据附件.md
!/reports/publication/人生变化测评-逐题明细.csv
!/reports/publication/AI算命重测-自媒体成稿.md
!/runs/
/runs/*
!/runs/v6-consumer-events/
/runs/v6-consumer-events/*
!/runs/v6-consumer-events/answers/
!/runs/v6-consumer-events/controls/
!/runs/v6-consumer-events/probes/
!/runs/v6-consumer-events/inputs/
!/runs/v6-consumer-events/control_inputs/
!/runs/v6-consumer-events/metadata/
!/runs/v6-consumer-events/protocol.md
!/runs/v6-consumer-events/predictor-instructions.md
!/runs/v6-consumer-events/adjudications.json
/runs/v6-consumer-events/answers/*
!/runs/v6-consumer-events/answers/*.json
/runs/v6-consumer-events/controls/*
!/runs/v6-consumer-events/controls/*.json
/runs/v6-consumer-events/probes/*
!/runs/v6-consumer-events/probes/*.json
/runs/v6-consumer-events/inputs/*
!/runs/v6-consumer-events/inputs/*.json
/runs/v6-consumer-events/control_inputs/*
!/runs/v6-consumer-events/control_inputs/*.json
/runs/v6-consumer-events/metadata/*
!/runs/v6-consumer-events/metadata/source-versions.json
!/runs/v6-consumer-events/metadata/semantic-audit.json
!/provenance/
/provenance/*
!/provenance/public-release-manifest.json
# Defense in depth for all included directories.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/node_modules/
**/.git/
**/superseded/
.env
.env.*
*.pem
*.key
